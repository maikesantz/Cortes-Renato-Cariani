# === Chaves de API necessárias ===
# Crie cada uma e cole o valor após o "=". Renomeie este arquivo pra .env

# 1. Anthropic (Claude) — análise dos trechos
# Como obter: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Groq — transcrição rápida via Whisper
# Como obter: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. YouTube Data API v3 — metadados (título, descrição, duração)
# Como obter: https://console.cloud.google.com → ativar YouTube Data API v3 → credencial
YOUTUBE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Configurações ===
# Modelo Claude a usar (sonnet 4.6 recomendado)
CLAUDE_MODEL=claude-sonnet-4-6

# Modelo de transcrição na Groq
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Pasta onde salvar áudios baixados e transcrições
DATA_DIR=./data

# Idioma esperado dos vídeos
LANG=pt
